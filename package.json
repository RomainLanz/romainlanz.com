{
	"private": true,
	"license": "UNLICENSED",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		]
	},
	"type": "module",
	"scripts": {
		"dev": "yarn workspace @rlanz/site dev",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:build": "docker build . -t site",
		"docker:run": "docker run --env-file ./apps/romainlanz.com/.env -e NODE_ENV=production -e HOST=0.0.0.0 -e DB_HOST=host.docker.internal -it -p 3333:3333 --add-host=host.docker.internal:host-gateway site",
		"lint": "oxlint",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint:fix": "oxlint --fix",
		"release": "node bin/release.mjs",
		"taze": "yarn dlx taze -r -I --maturity-period 3",
		"typecheck": "yarn workspaces foreach -p -A run typecheck"
	},
	"devDependencies": {
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0"
	},
	"engines": {
		"node": ">=26.13.1 <27"
	},
	"packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
