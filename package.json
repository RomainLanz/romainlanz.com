{
	"private": true,
	"license": "UNLICENSED",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		]
	},
	"type": "module",
	"scripts": {
		"dev": "yarn workspace @rlanz/site dev",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:build": "docker build . -t site",
		"docker:run": "docker run --env-file ./apps/romainlanz.com/.env -e NODE_ENV=production -e HOST=0.0.0.0 -e DB_HOST=host.docker.internal -it -p 3333:3333 --add-host=host.docker.internal:host-gateway site",
		"lint": "oxlint",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint:fix": "oxlint --fix",
		"release": "node bin/release.mjs",
		"taze": "yarn dlx taze -r -I --maturity-period 3",
		"typecheck": "yarn workspaces foreach -p -A run typecheck"
	},
	"devDependencies": {
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0"
	},
	"packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
