#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
app_root="$repo_root/apps/romainlanz.com"
mise_bin="$HOME/.local/bin/mise"

echo "==> Installing required system packages"
system_packages=(ca-certificates curl gnupg)
missing_system_packages=()
for package in "${system_packages[@]}"; do
	if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
		missing_system_packages+=("$package")
	fi
done

if (( ${#missing_system_packages[@]} > 0 )); then
	sudo apt-get update
	sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_system_packages[@]}"
fi

echo "==> Installing the repository toolchain"
if [[ ! -x "$mise_bin" ]]; then
	curl --proto '=https' --tlsv1.2 -sSf https://mise.run | sh
fi

profile_marker="# romainlanz.com mise environment"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
	cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ "\${PWD:-}" == "$repo_root" && -x "$mise_bin" ]]; then
	eval "\$("$mise_bin" activate bash)"
fi
EOF
fi

"$mise_bin" install
"$mise_bin" exec -- corepack enable
"$mise_bin" exec -- yarn install --immutable

echo "==> Installing Mailpit"
if ! command -v mailpit >/dev/null 2>&1; then
	mailpit_version=v1.30.6
	case "$(dpkg --print-architecture)" in
		amd64) mailpit_arch=amd64 ;;
		arm64) mailpit_arch=arm64 ;;
		*)
			echo "Unsupported Mailpit architecture: $(dpkg --print-architecture)" >&2
			exit 1
			;;
	esac

	mailpit_archive="$(mktemp)"
	curl --proto '=https' --tlsv1.2 -sSfL \
		"https://github.com/axllent/mailpit/releases/download/$mailpit_version/mailpit-linux-$mailpit_arch.tar.gz" \
		-o "$mailpit_archive"
	sudo tar -xzf "$mailpit_archive" -C /usr/local/bin mailpit
	rm -f "$mailpit_archive"
fi

echo "==> Configuring PostgreSQL"
pgdg_keyring=/usr/share/keyrings/postgresql-pgdg.asc
pgdg_source=/etc/apt/sources.list.d/postgresql-pgdg.sources
pgdg_key_fingerprint=B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8
pgdg_changed=false
pgdg_tmp_dir="$(mktemp -d)"
trap 'rm -rf "$pgdg_tmp_dir"' EXIT
install -d -m 0700 "$pgdg_tmp_dir/gnupg"

key_fingerprint() {
	gpg --batch --quiet --homedir "$pgdg_tmp_dir/gnupg" --show-keys --with-colons "$1" 2>/dev/null \
		| awk -F: '$1 == "fpr" { print $10; exit }'
}

installed_key_fingerprint=
if [[ -f "$pgdg_keyring" ]]; then
	installed_key_fingerprint="$(key_fingerprint "$pgdg_keyring" || true)"
fi

if [[ "$installed_key_fingerprint" != "$pgdg_key_fingerprint" ]]; then
	pgdg_downloaded_key="$pgdg_tmp_dir/postgresql-pgdg.asc"
	curl --proto '=https' --tlsv1.2 -sSfL \
		https://www.postgresql.org/media/keys/ACCC4CF8.asc \
		-o "$pgdg_downloaded_key"

	if [[ "$(key_fingerprint "$pgdg_downloaded_key")" != "$pgdg_key_fingerprint" ]]; then
		echo "PostgreSQL repository key fingerprint does not match" >&2
		exit 1
	fi

	sudo install -m 0644 "$pgdg_downloaded_key" "$pgdg_keyring"
	pgdg_changed=true
fi

cat > "$pgdg_tmp_dir/postgresql-pgdg.sources" <<EOF
Types: deb
URIs: https://apt.postgresql.org/pub/repos/apt
Suites: bookworm-pgdg
Architectures: $(dpkg --print-architecture)
Components: main
Signed-By: $pgdg_keyring
EOF

if ! sudo test -f "$pgdg_source" || ! sudo cmp -s "$pgdg_tmp_dir/postgresql-pgdg.sources" "$pgdg_source"; then
	sudo install -m 0644 "$pgdg_tmp_dir/postgresql-pgdg.sources" "$pgdg_source"
	pgdg_changed=true
fi

if [[ "$pgdg_changed" == true ]] \
	|| ! dpkg-query -W -f='${Status}' postgresql-18 2>/dev/null | grep -Fq 'install ok installed'; then
	sudo apt-get update
	sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y postgresql-18
fi

postgres_config=/etc/postgresql/18/main/conf.d/amp-orb.conf
if [[ ! -f "$postgres_config" ]]; then
	sudo tee "$postgres_config" >/dev/null <<'EOF'
# Favor speed over durability in this ephemeral development database.
fsync = off
full_page_writes = off
synchronous_commit = off
EOF
fi

if ! sudo pg_ctlcluster 18 main status >/dev/null 2>&1; then
	sudo pg_ctlcluster 18 main start
fi
if ! pg_isready -q; then
	echo "PostgreSQL failed to become ready" >&2
	exit 1
fi

if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = 'root'" | grep -q 1; then
	sudo -u postgres psql -v ON_ERROR_STOP=1 -c "CREATE ROLE root LOGIN PASSWORD 'root'"
else
	sudo -u postgres psql -v ON_ERROR_STOP=1 -c "ALTER ROLE root WITH LOGIN PASSWORD 'root'" >/dev/null
fi

for database in romainlanz romainlanz_test; do
	if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname = '$database'" | grep -q 1; then
		sudo -u postgres createdb --owner=root "$database"
	fi
done

echo "==> Creating the local application environment"
app_env="$app_root/.env"
if [[ ! -f "$app_env" ]]; then
	cp -- "$app_root/.env.example" "$app_env"
fi

if grep -Fqx 'APP_KEY=' "$app_env"; then
	app_key="$(openssl rand -base64 32 | tr -d '\n')"
	sed -i "s|^APP_KEY=$|APP_KEY=$app_key|" "$app_env"
fi

sed -i \
	-e 's/^TWITCH_CLIENT_ID=$/TWITCH_CLIENT_ID=orb-client-id/' \
	-e 's/^TWITCH_CLIENT_SECRET=$/TWITCH_CLIENT_SECRET=orb-client-secret/' \
	"$app_env"

echo "==> Running database migrations"
"$mise_bin" exec -- yarn workspace @rlanz/site exec node ace migrate

echo "==> Creating the local administrator"
"$mise_bin" exec -- yarn workspace @rlanz/site exec node ace create:user \
	--name='Orb Admin' \
	--email='admin@romainlanz.test' \
	--password='password' \
	--role=2 \
	--update

echo "    Email: admin@romainlanz.test"
echo "    Password: password"

echo "==> Orb setup complete"
